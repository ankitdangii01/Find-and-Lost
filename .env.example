# Supabase configuration (placeholder)

# Local development: copy this file to `.env.local` and fill in your values.
# Vercel: add these two variables in the Vercel dashboard (Project -> Settings -> Environment Variables)
# for the Production/Preview/Development environments, or run:  vercel env add VITE_SUPABASE_URL

# Confirm the publishable (anon) key is safe for the frontend because RLS protects the data.

VITE_SUPABASE_URL=your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key